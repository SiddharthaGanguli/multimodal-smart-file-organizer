APP_NAME=Multimodal Smart File Organizer
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Private local storage. Do not point this at a public web directory.
STORAGE_DIR=storage

# Planned services. These become active in later milestones.
DATABASE_URL=postgresql+psycopg://smartfile:smartfile@db:5432/smartfile
REDIS_URL=redis://redis:6379/0

# Google Drive values will be added when Milestone 11 begins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
