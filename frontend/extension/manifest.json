{
  "manifest_version": 3,
  "name": "Filewise — Your Drive Library",
  "version": "0.3.0",
  "description": "Upload and organize a private library of files in your own Google Drive.",
  "minimum_chrome_version": "125",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "http://127.0.0.1/*"
  ],
  "oauth2": {
    "client_id": "305934899702-prd0qghi34ijrcud27cs3o2rrpap42jf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_title": "Open Filewise"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; connect-src 'self' https://www.googleapis.com http://127.0.0.1:8000; frame-src http://127.0.0.1:8765 https://siddharthaganguli.github.io; base-uri 'none'"
  },
  "key": ""
}
